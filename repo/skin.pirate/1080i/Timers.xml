<?xml version="1.0" encoding="UTF-8"?>
<timers>
    <timer>
        <name>spotlightanimation</name>
        <description>Spotlight animation</description>
        <start reset="true">Control.HasFocus(1508)</start>
        <reset>!Control.HasFocus(1508)</reset>
    </timer>
    <timer>
        <name>piratestartupintro</name>
        <description>Dismiss the startup mask when its intro ends or stops.</description>
        <start reset="true">Window.IsVisible(1103) + Player.HasVideo + [String.IsEqual(Player.Filename,bingie_intro_1080p.mp4) | String.IsEqual(Player.Filename,bingie_intro_2160p.mp4)]</start>
        <stop>!Window.IsVisible(1103) | !Player.HasVideo</stop>
        <onstop condition="Window.IsVisible(1103) + String.IsEqual(Skin.String(splash_screen),bingie_default)">ClearProperty(StartupMask,Home)</onstop>
    </timer>
</timers>
