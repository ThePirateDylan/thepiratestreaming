<?xml version="1.0" encoding="UTF-8"?>
<!-- BINGIE -->
<window id="1102">
	<zorder>999</zorder>
	<defaultcontrol always="true">100</defaultcontrol>
	<onload>AlarmClock(FocusStartUpButton,SetFocus(100),00:00,silent)</onload>
	<controls>
		<control type="group">
			<control type="image">
				<animation effect="fade" end="100" time="200">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
				<animation effect="fade" end="100" time="200">Visible</animation>
				<animation effect="fade" start="100" end="0" time="200">Hidden</animation>
				<include>FullscreenDimensions</include>
				<texture background="true" colordiffuse="cc111315">colors/color_white.png</texture>
			</control>
			<control type="scrollbar" id="3000">
				<include>HiddenObject</include>
			</control>
			<control type="grouplist">
				<include>Startup_Dialog_OpenClose</include>
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>900</width>
				<height max="940">auto</height>
				<orientation>vertical</orientation>
				<itemgap>25</itemgap>
				<align>center</align>
				<!-- Pirate Streaming wordmark -->
				<control type="group"><width>500</width><height>180</height>
					<control type="label"><left>181</left><top>10</top><width>130</width><height>34</height><font>Bold24</font><textcolor>ffd7d9dc</textcolor><shadowcolor>cc000000</shadowcolor><align>left</align><aligny>center</aligny><label>The</label></control>
					<control type="label"><left>144</left><top>25</top><width>390</width><height>75</height><font>Bold75</font><textcolor>ffff7417</textcolor><shadowcolor>e6000000</shadowcolor><align>left</align><aligny>center</aligny><label>Pirate</label></control>
					<control type="label"><left>163</left><top>99</top><width>380</width><height>50</height><font>Bold38</font><textcolor>ffe5e7e9</textcolor><shadowcolor>cc000000</shadowcolor><align>left</align><aligny>center</aligny><label>Streaming</label></control>
					<control type="image"><left>164</left><top>152</top><width>245</width><height>4</height><texture colordiffuse="ff78c92b">colors/color_white.png</texture></control>
				</control>
				<!-- message -->
				<control id="5" type="textbox">
					<centerleft>50%</centerleft>
					<width>100%</width>
					<height max="745">auto</height>
					<font>Reg24</font>
					<autoscroll>false</autoscroll>
					<align>left</align>
					<textcolor>white</textcolor>
					<aligny>top</aligny>
					<pagecontrol>3000</pagecontrol>
					<label>$LOCALIZE[31395]</label>
				</control>
				<!-- Button -->
				<control type="grouplist" id="100">
					<height>55</height>
					<width>100%</width>
					<orientation>horizontal</orientation>
					<itemgap>25</itemgap>
					<align>center</align>
					<onright>noop</onright>
					<onleft>noop</onleft>
					<control type="button" id="101">
						<width min="302" max="438">auto</width>
						<height>54</height>
						<font>Reg24</font>
						<textcolor>a6ffffff</textcolor>
						<focusedcolor>ff111315</focusedcolor>
						<selectedcolor>ff111315</selectedcolor>
						<textoffsetx>20</textoffsetx>
						<aligny>center</aligny>
						<align>center</align>
						<texturefocus border="10" colordiffuse="white">bingie/border/default_button_focus.png</texturefocus>
						<alttexturefocus border="10" colordiffuse="white">bingie/border/default_button_focus.png</alttexturefocus>
						<label>$LOCALIZE[31396]</label>
						<onclick>Skin.SetBool(BingieSecondStartupDone)</onclick>
						<onclick>SetProperty(finishBingieStartup2,1,Home)</onclick>
						<onclick>ClearProperty(StartupMask,Home)</onclick>
						<onclick>AlarmClock(clear_property,ClearProperty(finishBingieStartup2,Home),00:02,silent)</onclick>
						<onclick>AlarmClock(delay_window,ReplaceWindow(Videos,sources://video/),00:01,silent)</onclick>
						<onup>PageUp(3000)</onup>
						<ondown>PageDown(3000)</ondown>
					</control>
					<control type="button" id="102">
						<width min="302" max="438">auto</width>
						<height>54</height>
						<font>Reg24</font>
						<textcolor>a6ffffff</textcolor>
						<focusedcolor>ff111315</focusedcolor>
						<selectedcolor>ff111315</selectedcolor>
						<textoffsetx>20</textoffsetx>
						<aligny>center</aligny>
						<align>center</align>
						<texturefocus border="10" colordiffuse="white">bingie/border/default_button_focus.png</texturefocus>
						<alttexturefocus border="10" colordiffuse="white">bingie/border/default_button_focus.png</alttexturefocus>
						<label>$LOCALIZE[31397]</label>
						<onclick>Skin.SetBool(BingieSecondStartupDone)</onclick>
						<onclick>SetProperty(finishBingieStartup2,1,Home)</onclick>
						<onclick>ClearProperty(StartupMask,Home)</onclick>
						<onclick>AlarmClock(clear_property,ClearProperty(finishBingieStartup2,Home),00:02,silent)</onclick>
						<onclick>AlarmClock(delay_window,ReplaceWindow($VAR[StartUpWindow]),00:01,silent)</onclick>
						<onup>PageUp(3000)</onup>
						<ondown>PageDown(3000)</ondown>
					</control>
				</control>
				<!-- fake progress -->
				<control type="group">
					<width>901</width>
					<height>10</height>
					<control type="image">
						<width>100%</width>
						<height>100%</height>
						<texture colordiffuse="ff25292e" border="2">colors/color_white.png</texture>
					</control>
					<control type="image">
						<width>50%</width>
						<height>100%</height>
						<texture colordiffuse="ffff7417" border="4">diffuse/panel2.png</texture>
						<animation effect="zoom" end="200,100" easing="in" tween="cubic" time="600" condition="!String.IsEmpty(Window(Home).Property(finishBingieStartup2))">Conditional</animation>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>