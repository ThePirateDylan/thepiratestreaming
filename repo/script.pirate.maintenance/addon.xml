<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.pirate.maintenance" name="The Pirate Maintenance" version="1.0.7" provider-name="The Pirate Dylan">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py"/>
    <extension point="xbmc.service" library="service.py" start="startup"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Maintenance tools for The Pirate.</summary>
        <description lang="en_GB">Cleans old temporary files and installer packages at startup while preserving media caches. Includes a separate Pirate artwork refresh and full manual cleanup.</description>
        <news>Fixed manual cleanup progress dialogs and protected active cache databases. Startup now confirms completion even when no files need removing.</news>
        <platform>all</platform>
        <license>GPL v2.0</license>
        <assets>
            <icon>pirate-branding-20261125-icon.png</icon>
        <fanart>pirate-branding-20261125-fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
